{
  "expo": {
    "name": "Arma tu outfit",
    "slug": "arma-tu-outfit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F3EC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.armatuoutfit.prototype",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.armatuoutfit.prototype"
    },
    "web": {
      "name": "Arma tu outfit",
      "bundler": "metro"
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Elige una foto para guardar tu prenda en este dispositivo.",
          "cameraPermission": "Toma una foto para agregar una prenda a tu clóset.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usa tu ubicación aproximada para encontrar tu ciudad y mostrar su clima.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosReducedAccuracyByDefault": true
        }
      ]
    ]
  }
}

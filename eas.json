{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_SHOW_COMING_SOON": "1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "env": { "EXPO_PUBLIC_SHOW_COMING_SOON": "1" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
